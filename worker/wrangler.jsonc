{
  "name": "paypal-ai-expense-agent-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],

  // Workers AI binding — free LLM inference at the edge
  "ai": {
    "binding": "AI"
  },

  // D1 Database for persistent storage
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paypal-expense-db",
      "database_id": "b34cea56-bfd2-4f76-a4af-995fc3831b1e"
    }
  ],

  // KV namespace for caching PayPal tokens and transaction data
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "b8ce9db47a284d45b61956b89568d860",
      "preview_id": "fe80ec00fd6a4170a1e17afca5de22a2"
    }
  ],

  // Durable Object for the AI Agent
  "durable_objects": {
    "bindings": [
      {
        "name": "EXPENSE_AGENT",
        "class_name": "ExpenseAgent",
        "script_name": "paypal-ai-expense-agent-worker"
      }
    ]
  },

  // Durable Object migrations
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ExpenseAgent"]
    }
  ],

  // Observability
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1.0
  },

  // Environment variables (use wrangler secret for sensitive data)
  "vars": {
    "ALLOWED_ORIGIN": "http://localhost:3000",
    "PAYPAL_API_BASE": "https://api-m.sandbox.paypal.com"
  }
}
